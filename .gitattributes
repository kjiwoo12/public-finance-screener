# 받아 둔 원본과 표는 기계가 만들어 커밋하는 산출물이다. 체크아웃 때
# 줄바꿈이 바뀌면 다시 만들었을 때 내용이 같은데도 diff 가 뜬다.
# 수집기가 LF 로 쓰므로 저장소와 작업 사본을 둘 다 LF 로 고정한다.
data/raw/*.xml        text eol=lf
data/snapshot/*.csv   text eol=lf

# 대조 자료는 화면에서 옮긴 것이라 손으로 만든 파일에 가깝지만, 같은 이유로
# 줄바꿈을 고정해 둔다. 탭으로 나뉜 표라 줄이 밀리면 열이 어긋난다.
data/benchmark/*.tsv  text eol=lf

# 조서는 렌더해서 커밋한다. 같은 자료에서 같은 바이트가 나오는 것을 테스트로
# 고정해 뒀는데, 체크아웃에서 줄바꿈이 바뀌면 그 보장이 저장소 밖에서 깨진다.
docs/*.html           text eol=lf
